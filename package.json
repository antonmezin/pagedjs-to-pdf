{
  "name": "pagedjs-react-document-generator",
  "version": "1.0.0",
  "description": "Generate paginated HTML documents using PagedJS and React",
  "main": "src/generator.js",
  "scripts": {
    "generate": "babel-node src/generator.js",
    "generate:300": "babel-node src/generator.js --300pages",
    "generate:chunks": "babel-node src/generator.js --chunks",
    "generate:chunks:300": "babel-node src/generator.js --300pages --chunks",
    "generate:pdf": "babel-node src/generator.js --chunks --pdf",
    "generate:300:pdf": "babel-node src/generator.js --300pages --chunks --pdf",
    "dev": "babel-node src/generator.js && open output/document.html",
    "dev:chunks": "babel-node src/generator.js --chunks && open output/chunks/index.html",
    "dev:pdf": "babel-node src/generator.js --chunks --pdf && open output/chunks/index.html",
    "test:300": "babel-node src/generator.js --300pages && open output/document-300pages.html",
    "test:chunks:300": "babel-node src/generator.js --300pages --chunks && open output/chunks/index.html",
    "test:pdf:300": "babel-node src/generator.js --300pages --chunks --pdf && open output/chunks/index.html"
  },
  "dependencies": {
    "fs-extra": "^11.1.1",
    "jsdom": "^22.1.0",
    "pagedjs": "^0.4.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/node": "^7.29.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/register": "^7.22.0"
  },
  "keywords": [
    "pagedjs",
    "react",
    "document",
    "pdf",
    "pagination"
  ],
  "author": "",
  "license": "MIT"
}
